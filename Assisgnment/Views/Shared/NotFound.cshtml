@{
    ViewData["Title"] = "Page Not Found";
}

<div class="text-center py-5">
    <div class="display-1 text-danger fw-bold"><i class="fa-solid fa-circle-question me-2"></i>404</div>
    <h1 class="display-5 fw-semibold mt-3">Page Not Found</h1>
    <p class="lead text-muted">The resource or page you requested could not be located.</p>
    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i>Return Home</a>
</div>
