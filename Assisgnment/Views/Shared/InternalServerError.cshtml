@{
    ViewData["Title"] = "Server Error";
}

<div class="text-center py-5">
    <div class="display-1 text-warning fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>500</div>
    <h1 class="display-5 fw-semibold mt-3">Internal Server Error</h1>
    <p class="lead text-muted">An unexpected error occurred while processing your request. Please try again later.</p>
    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i>Return Home</a>
</div>
