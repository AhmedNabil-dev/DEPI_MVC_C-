@{
    ViewData["Title"] = "Dashboard";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-primary"><i class="fa-solid fa-hospital-user text-danger me-2"></i>CareHospital Management</h1>
        <p class="col-md-8 fs-5 text-muted">A comprehensive, multi-tiered ASP.NET Core MVC solution managing Doctors, Patients, and Appointment Scheduling with Entity Framework Core and Repository Pattern.</p>
        <div class="d-flex gap-2">
            <a asp-controller="Appointments" asp-action="Create" class="btn btn-info text-white btn-lg"><i class="fa-solid fa-calendar-plus me-1"></i>Book Appointment</a>
            <a asp-controller="Doctors" asp-action="Create" class="btn btn-primary btn-lg"><i class="fa-solid fa-user-doctor me-1"></i>Add Doctor</a>
            <a asp-controller="Patients" asp-action="Create" class="btn btn-success btn-lg"><i class="fa-solid fa-hospital-user me-1"></i>Add Patient</a>
        </div>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-primary">
            <div class="card-body text-center p-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex p-3 mb-3">
                    <i class="fa-solid fa-user-doctor fa-3x"></i>
                </div>
                <h4 class="card-title fw-bold">Doctors</h4>
                <p class="card-text text-muted">Manage hospital doctors, specializations, contacts, salary details, and profile photos.</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-primary"><i class="fa-solid fa-list me-1"></i>View All Doctors</a>
                    <a asp-controller="Doctors" asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Register Doctor</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-success">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex p-3 mb-3">
                    <i class="fa-solid fa-hospital-user fa-3x"></i>
                </div>
                <h4 class="card-title fw-bold">Patients</h4>
                <p class="card-text text-muted">Register and update patient records, personal details, contact information, and medical appointments.</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Patients" asp-action="Index" class="btn btn-outline-success"><i class="fa-solid fa-list me-1"></i>View All Patients</a>
                    <a asp-controller="Patients" asp-action="Create" class="btn btn-success"><i class="fa-solid fa-plus me-1"></i>Register Patient</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100 shadow-sm border-info">
            <div class="card-body text-center p-4">
                <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex p-3 mb-3">
                    <i class="fa-solid fa-calendar-check fa-3x"></i>
                </div>
                <h4 class="card-title fw-bold">Appointments</h4>
                <p class="card-text text-muted">Schedule, review, track, and update clinic appointments between patients and specialized doctors.</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-info"><i class="fa-solid fa-list me-1"></i>View Schedule</a>
                    <a asp-controller="Appointments" asp-action="Create" class="btn btn-info text-white"><i class="fa-solid fa-plus me-1"></i>Book Appointment</a>
                </div>
            </div>
        </div>
    </div>
</div>
