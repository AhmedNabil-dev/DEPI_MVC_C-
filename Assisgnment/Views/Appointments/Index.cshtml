@model PaginatedList<AppointmentViewModel>
@{
    ViewData["Title"] = "Appointments";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2 class="text-info"><i class="fa-solid fa-calendar-check me-2"></i>Appointments Schedule</h2>
    <a asp-action="Create" class="btn btn-info text-white"><i class="fa-solid fa-plus me-1"></i>Book New Appointment</a>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-sm-8">
                <input class="form-control" placeholder="Search by Doctor, Patient or Status..." name="searchValue" value="@Context.Request.Query["searchValue"]" />
            </div>
            <div class="col-md-3 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-info text-white flex-grow-1"><i class="fa-solid fa-magnifying-glass me-1"></i>Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Date & Time</th>
                    <th scope="col">Doctor</th>
                    <th scope="col">Patient</th>
                    <th scope="col">Status</th>
                    <th scope="col">Notes</th>
                    <th scope="col" class="text-center" colspan="3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in Model)
                {
                    <tr>
                        <td class="fw-bold">@appointment.AppointmentDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <div><i class="fa-solid fa-user-doctor text-primary me-1"></i>@appointment.Doctor?.Name</div>
                            <small class="text-muted">@appointment.Doctor?.Specialization</small>
                        </td>
                        <td>
                            <div><i class="fa-solid fa-hospital-user text-success me-1"></i>@appointment.Patient?.Name</div>
                            <small class="text-muted">@appointment.Patient?.Phone</small>
                        </td>
                        <td>
                            @if (appointment.Status == "Completed")
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Completed</span>
                            }
                            else if (appointment.Status == "Cancelled")
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-xmark me-1"></i>Cancelled</span>
                            }
                            else if (appointment.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-primary"><i class="fa-solid fa-calendar-check me-1"></i>Scheduled</span>
                            }
                        </td>
                        <td>
                            @(string.IsNullOrEmpty(appointment.Notes) ? "-" : (appointment.Notes.Length > 40 ? appointment.Notes.Substring(0, 40) + "..." : appointment.Notes))
                        </td>
                        <partial name="_ButtonsPartial" model="@appointment.Id.ToString()" />
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Appointments pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.PageIndex of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
else
{
    <div class="alert alert-warning mt-4 text-center">
        <h4><i class="fa-solid fa-triangle-exclamation me-2"></i>No Appointments Found</h4>
        <p class="mb-0">There are no appointments registered in the system or matching your search criteria.</p>
    </div>
}
