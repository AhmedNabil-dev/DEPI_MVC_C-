@model PaginatedList<DoctorViewModel>
@{
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2 class="text-primary"><i class="fa-solid fa-user-doctor me-2"></i>Doctors Directory</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Add New Doctor</a>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-sm-8">
                <input class="form-control" placeholder="Search by Doctor Name or Specialization..." name="searchValue" value="@Context.Request.Query["searchValue"]" />
            </div>
            <div class="col-md-3 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-info text-white flex-grow-1"><i class="fa-solid fa-magnifying-glass me-1"></i>Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Photo</th>
                    <th scope="col">Name</th>
                    <th scope="col">Specialization</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Email</th>
                    <th scope="col">Salary</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-center" colspan="3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(doctor.ImageName))
                            {
                                <img src="~/Files/Images/@doctor.ImageName" alt="@doctor.Name" class="rounded-circle" style="width: 45px; height: 45px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                    <i class="fa-solid fa-user-doctor"></i>
                                </div>
                            }
                        </td>
                        <td class="fw-bold">@doctor.Name</td>
                        <td><span class="badge bg-info text-dark">@doctor.Specialization</span></td>
                        <td>@doctor.Phone</td>
                        <td>@doctor.Email</td>
                        <td>@doctor.Salary.ToString("C")</td>
                        <td>
                            @if (doctor.IsActive)
                            {
                                <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-circle-xmark me-1"></i>Inactive</span>
                            }
                        </td>
                        <partial name="_ButtonsPartial" model="@doctor.Id.ToString()" />
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Doctors pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.PageIndex of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
else
{
    <div class="alert alert-warning mt-4 text-center">
        <h4><i class="fa-solid fa-triangle-exclamation me-2"></i>No Doctors Found</h4>
        <p class="mb-0">There are no doctors registered in the system or matching your search criteria.</p>
    </div>
}
