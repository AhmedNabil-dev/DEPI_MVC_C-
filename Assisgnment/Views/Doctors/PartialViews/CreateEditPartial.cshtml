@model DoctorViewModel

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ImageName" />

<div class="form-group mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input class="form-control" asp-for="Name" placeholder="Dr. John Doe" />
    <span class="text-danger" asp-validation-for="Name"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Specialization" class="form-label"></label>
    <input class="form-control" asp-for="Specialization" placeholder="e.g. Cardiology, Neurology" />
    <span class="text-danger" asp-validation-for="Specialization"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Image" class="form-label">Doctor Photo</label>
    <input class="form-control" type="file" asp-for="Image" accept="image/*" />
</div>

<div class="form-group mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input class="form-control" asp-for="Email" placeholder="doctor@hospital.com" />
    <span class="text-danger" asp-validation-for="Email"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <input class="form-control" asp-for="Phone" placeholder="+1234567890" />
    <span class="text-danger" asp-validation-for="Phone"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Address" class="form-label"></label>
    <input class="form-control" asp-for="Address" />
    <span class="text-danger" asp-validation-for="Address"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Salary" class="form-label"></label>
    <input class="form-control" asp-for="Salary" type="number" step="0.01" />
    <span class="text-danger" asp-validation-for="Salary"></span>
</div>

<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="IsActiveCheck" />
    <label class="form-check-label" for="IsActiveCheck">Active Status</label>
</div>
