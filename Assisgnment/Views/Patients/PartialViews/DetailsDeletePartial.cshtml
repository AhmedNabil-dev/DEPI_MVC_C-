@model PatientViewModel

<div class="form-group mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input readonly class="form-control" asp-for="Name" />
</div>

<div class="row">
    <div class="col-md-6 form-group mb-3">
        <label asp-for="Age" class="form-label"></label>
        <input readonly class="form-control" asp-for="Age" />
    </div>
    <div class="col-md-6 form-group mb-3">
        <label asp-for="Gender" class="form-label"></label>
        <input readonly class="form-control" asp-for="Gender" />
    </div>
</div>

<div class="row">
    <div class="col-md-6 form-group mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input readonly class="form-control" asp-for="Phone" />
    </div>
    <div class="col-md-6 form-group mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input readonly class="form-control" asp-for="Email" />
    </div>
</div>

<div class="form-group mb-3">
    <label asp-for="DateOfBirth" class="form-label"></label>
    <input readonly class="form-control" value="@Model.DateOfBirth?.ToString("yyyy-MM-dd")" />
</div>

<div class="form-group mb-3">
    <label asp-for="Address" class="form-label"></label>
    <input readonly class="form-control" asp-for="Address" />
</div>
