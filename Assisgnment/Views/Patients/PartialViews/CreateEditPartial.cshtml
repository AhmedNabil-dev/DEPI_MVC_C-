@model PatientViewModel

<input type="hidden" asp-for="Id" />

<div class="form-group mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input class="form-control" asp-for="Name" placeholder="Full Name" />
    <span class="text-danger" asp-validation-for="Name"></span>
</div>

<div class="row">
    <div class="col-md-6 form-group mb-3">
        <label asp-for="Age" class="form-label"></label>
        <input class="form-control" asp-for="Age" type="number" min="0" max="120" />
        <span class="text-danger" asp-validation-for="Age"></span>
    </div>
    <div class="col-md-6 form-group mb-3">
        <label asp-for="Gender" class="form-label"></label>
        <select class="form-select" asp-for="Gender">
            <option value="">-- Select Gender --</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
        </select>
        <span class="text-danger" asp-validation-for="Gender"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 form-group mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input class="form-control" asp-for="Phone" placeholder="+1234567890" />
        <span class="text-danger" asp-validation-for="Phone"></span>
    </div>
    <div class="col-md-6 form-group mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input class="form-control" asp-for="Email" placeholder="patient@example.com" />
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>
</div>

<div class="form-group mb-3">
    <label asp-for="DateOfBirth" class="form-label"></label>
    <input class="form-control" asp-for="DateOfBirth" type="date" />
    <span class="text-danger" asp-validation-for="DateOfBirth"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Address" class="form-label"></label>
    <input class="form-control" asp-for="Address" />
    <span class="text-danger" asp-validation-for="Address"></span>
</div>
