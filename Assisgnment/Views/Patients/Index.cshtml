@model PaginatedList<PatientViewModel>
@{
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2 class="text-success"><i class="fa-solid fa-hospital-user me-2"></i>Patients Directory</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fa-solid fa-user-plus me-1"></i>Add New Patient</a>
</div>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-9 col-sm-8">
                <input class="form-control" placeholder="Search by Patient Name or Phone Number..." name="searchValue" value="@Context.Request.Query["searchValue"]" />
            </div>
            <div class="col-md-3 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-info text-white flex-grow-1"><i class="fa-solid fa-magnifying-glass me-1"></i>Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Age</th>
                    <th scope="col">Gender</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Email</th>
                    <th scope="col">Address</th>
                    <th scope="col">Date of Birth</th>
                    <th scope="col" class="text-center" colspan="3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in Model)
                {
                    <tr>
                        <td class="fw-bold">@patient.Name</td>
                        <td>@patient.Age</td>
                        <td>
                            @if (patient.Gender.Equals("Male", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-primary"><i class="fa-solid fa-mars me-1"></i>Male</span>
                            }
                            else
                            {
                                <span class="badge bg-danger"><i class="fa-solid fa-venus me-1"></i>Female</span>
                            }
                        </td>
                        <td>@patient.Phone</td>
                        <td>@patient.Email</td>
                        <td>@patient.Address</td>
                        <td>@(patient.DateOfBirth?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <partial name="_ButtonsPartial" model="@patient.Id.ToString()" />
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Patients pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.PageIndex of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Index" asp-route-searchValue="@Context.Request.Query["searchValue"]" asp-route-pageIndex="@(Model.PageIndex + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
else
{
    <div class="alert alert-warning mt-4 text-center">
        <h4><i class="fa-solid fa-triangle-exclamation me-2"></i>No Patients Found</h4>
        <p class="mb-0">There are no patients registered in the system or matching your search criteria.</p>
    </div>
}
