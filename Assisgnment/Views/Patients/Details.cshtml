@model PatientViewModel
@{
    ViewData["Title"] = "Patient Details";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="fa-solid fa-circle-info me-2"></i>Patient Details</h4>
            </div>
            <div class="card-body">
                <partial name="PartialViews/DetailsDeletePartial" model="@Model" />
                <div class="d-flex gap-2 mt-4">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="fa-solid fa-pen-to-square me-1"></i>Edit</a>
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>
